// Prisma schema for the Phoneme Activity Builder (Assessments 2 and 3).
//
// Data model overview:
//   WordList  ─┬─ has many ─> Word ── has many ─> Phoneme
//              └─ has many ─> ActivityConfig
//
// Observability / reporting (Assessment 3) — append-only event tables
// that the dashboard and reports aggregate over time:
//   GenerationEvent  one row per attempt to generate an activity file
//   PageView         one row per page visit, with visible time on page
//   AuditEvent       one row per builder create / update / delete
//
// Event tables deliberately hold plain ids (no foreign keys) so the
// history survives when the word list or activity it refers to is
// deleted. `simulated` marks rows produced by the usage simulator so
// they can be told apart from (and cleared without touching) real use.
//
// A phoneme is stored as its own row with a string `symbol` and an
// integer `position`, so multi-character IPA tokens (e.g. "tʃ", "əʉ",
// "ɐː") are stored faithfully and their order within a word is
// preserved without any delimiter parsing.

generator client {
  provider = "prisma-client-js"
  // `native` covers local dev (Windows/macOS/Linux); the debian target
  // is for the node:22-slim (Debian 12 / OpenSSL 3) Docker image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A named collection of phoneme-based words a teacher can build
/// activities from.
model WordList {
  id            String           @id @default(cuid())
  name          String
  description   String?
  /// The dominant phoneme length for this list (3, 4 or 5). Used as the
  /// default difficulty when generating an activity; individual words
  /// may still vary.
  phonemeLength Int              @default(3)
  words         Word[]
  activities    ActivityConfig[]
  /// True when created by the usage simulator.
  simulated     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([name])
}

/// A single word within a WordList, together with its ordered phonemes.
model Word {
  id           String    @id @default(cuid())
  wordList     WordList   @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  wordListId   String
  /// English spelling, lower case (e.g. "chin").
  text         String
  /// Display spelling shown to students, upper case (e.g. "CHIN").
  displayText  String
  /// Denormalised count of phonemes, kept in sync on write so the API
  /// can filter/group by difficulty without loading every phoneme.
  phonemeCount Int        @default(0)
  /// Optional teaching hint for this specific word.
  hint         String?
  /// Free-text note (not shown to students).
  notes        String?
  /// Ordering of the word within its list.
  orderIndex   Int        @default(0)
  phonemes     Phoneme[]
  /// Activities that use this word as their Wordle target.
  targetedBy   ActivityConfig[] @relation("ActivityTargetWord")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([wordListId])
}

/// One phoneme (IPA token) at a fixed position within a Word.
model Phoneme {
  id       String @id @default(cuid())
  word     Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)
  wordId   String
  /// The IPA symbol. May be more than one character, e.g. "tʃ", "əʉ".
  symbol   String
  /// 0-based index of this phoneme within the word.
  position Int

  @@unique([wordId, position])
  @@index([wordId])
}

/// A saved Wordle or Word Search configuration built on top of a
/// WordList. Multiple configurations per list are supported.
model ActivityConfig {
  id           String   @id @default(cuid())
  name         String
  /// "WORDLE" or "WORD_SEARCH" (validated in the API layer).
  type         String
  wordList     WordList @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  wordListId   String
  /// Target phoneme length / difficulty for this activity (3, 4 or 5).
  difficulty   Int      @default(3)
  /// Wordle: maximum number of guesses. Null for Word Search.
  maxGuesses   Int?
  /// Wordle: pre-fill the first phoneme tile as a scaffold.
  prefillFirst Boolean  @default(false)
  /// Wordle: the target Word within the list. Null = auto-select the
  /// first word matching the difficulty. If the word is later deleted
  /// this is set back to null and the activity falls back to auto.
  targetWord   Word?    @relation("ActivityTargetWord", fields: [targetWordId], references: [id], onDelete: SetNull)
  targetWordId String?
  /// Word Search: square grid size (e.g. 8, 10, 12). Null for Wordle.
  gridSize     Int?
  /// Optional hint shown with the activity.
  hint         String?
  /// Optional note for students shown in the generated file footer.
  teacherNote  String?
  /// Any additional generation metadata as JSON (extensible without a
  /// migration), e.g. { "wordSearchCount": 5 }.
  outputSettings Json?
  /// True when created by the usage simulator.
  simulated    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([wordListId])
  @@index([type])
  @@index([targetWordId])
}

/// One attempt to generate a playable activity file, successful or not.
/// Written by the server-side generate route (saved activities) and by
/// the Wordle / Word Search builder pages via /api/telemetry/generation.
model GenerationEvent {
  id           String   @id @default(cuid())
  /// "WORDLE" or "WORD_SEARCH".
  activityType String
  /// "SAVED_ACTIVITY" (server route) or "BUILDER" (builder pages).
  source       String
  /// "SUCCESS" or "FAILED".
  status       String
  /// Why a failed attempt failed (null on success).
  errorMessage String?
  /// Saved activity / word list behind the attempt, when known.
  activityId   String?
  wordListId   String?
  /// Phoneme length of the activity (3, 4, 5 …).
  difficulty   Int?
  /// "preview" (opened in the browser) or "download" (saved as a file).
  mode         String   @default("preview")
  /// Server-side time spent building the file.
  durationMs   Int      @default(0)
  /// Size of the generated HTML file in bytes (null on failure).
  outputBytes  Int?
  simulated    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([activityType])
  @@index([wordListId])
}

/// A single visit to a page of the builder, recorded when the visitor
/// leaves (or hides) the page. `durationMs` counts visible time only.
model PageView {
  id         String   @id @default(cuid())
  /// App route, e.g. "/wordle" or "/dashboard".
  path       String
  durationMs Int
  simulated  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

/// Append-only audit trail of builder CRUD operations, so creation
/// counts stay accurate even after records are deleted.
model AuditEvent {
  id           String   @id @default(cuid())
  /// "WORD_LIST", "WORD" or "ACTIVITY".
  entityType   String
  /// "CREATE", "UPDATE" or "DELETE".
  action       String
  entityId     String
  /// Human-readable name of the record at the time of the change.
  label        String?
  /// For activities: "WORDLE" or "WORD_SEARCH".
  activityType String?
  simulated    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, action])
}
