# Copy to .env for local development:  cp .env.example .env
#
# PostgreSQL connection string used by Prisma.
#
# Local development (`npm run dev`) talks to the Postgres container
# published on localhost:5432 — start just the database with:
#
#   docker compose up -d db
#
# Inside Docker Compose the app and migrate services override this with
# the service hostname `db` instead of localhost (see docker-compose.yml).
POSTGRES_USER=phoneme
POSTGRES_PASSWORD=phoneme
POSTGRES_DB=phoneme
DATABASE_URL="postgresql://phoneme:phoneme@localhost:5432/phoneme?schema=public"
